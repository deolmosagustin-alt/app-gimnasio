<?xml version="1.0" encoding="utf-8"?>
<!-- Los tres widgets de Modus Fit usan este mismo molde: una imagen que
     dibuja WidgetDibujo (la barra, la tarjeta de la semana, los cajones).
     Todo el widget se toca y abre la app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/modus_widget_imagen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name"
        android:src="@drawable/widget_background"/>
</FrameLayout>
